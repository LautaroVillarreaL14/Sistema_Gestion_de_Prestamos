// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum EstadoPrestamo {
  ACTIVO
  FINALIZADO
  ATRASADO
}

enum EstadoCuota {
  PAGA
  IMPAGA
  VENCIDA
}

enum FormaDePago {
  EFECTIVO
  TRANSFERENCIA
  NINGUNA
  OTROS
}

model Cliente {
  idCliente String @id @default(uuid(7))
  nombre String @db.VarChar(50)
  apellido String @db.VarChar(50)
  numeroDNI String @db.VarChar(10) @unique
  email String? @db.VarChar(100)
  prestamos Prestamo[]
}

model Prestamo {
  idPrestamo String @id @default(uuid(7))
  estadoPrestamo EstadoPrestamo @default(ACTIVO)
  cliente Cliente @relation(fields: [idCliente], references: [idCliente])
  idCliente String
  montoPrestado Decimal @db.Decimal(12, 2)
  porcentajeRecargo Decimal @db.Decimal(5, 2)
  montoAdevolver Decimal @db.Decimal(12, 2)
  fechaHoraOtorgado DateTime @default(now())
  fechaHoraFinalizado DateTime?
  planDePago PlanDePago?
}

model PlanDePago {
  idPlanDePago String @id @default(uuid(7))
  diasEntreCuotas Int
  idPrestamo String @unique
  prestamo Prestamo @relation(fields: [idPrestamo], references: [idPrestamo])
  cuotas Cuota[]
  totalAPagar Decimal
}

model Cuota {
  idCuota String @id @default(uuid(7))
  estadoCuota EstadoCuota @default(IMPAGA)
  formaDePago FormaDePago @default(NINGUNA)
  numeroDeCuota Int
  montoCuota Decimal @db.Decimal(12,2)
  montoPagado Decimal @db.Decimal(12,2) @default(0)
  fechaInicioCuota DateTime
  fechaVencimientoCuota DateTime
  fechaHoraPagada DateTime?
  idPlanDePago String
  planDePago PlanDePago @relation(fields: [idPlanDePago], references: [idPlanDePago])
  @@unique([idPlanDePago, numeroDeCuota])
}